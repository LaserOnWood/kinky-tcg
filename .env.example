# URL du webhook Discord utilisée uniquement par la fonction serverless Vercel.
# Ne jamais préfixer cette variable par NEXT_PUBLIC_ ou VITE_.
FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/remplacer
# Une ou plusieurs URLs sont possibles : suffixes _1, _2, _3, etc.
DISCORD_NOTIFICATION_WEBHOOK_URL_1=https://discord.com/api/webhooks/remplacer
DISCORD_NOTIFICATION_WEBHOOK_URL_2=https://discord.com/api/webhooks/remplacer
